---
import { useTranslations } from '../i18n/ui';
import { withBase, type Locale } from '../i18n/routes';
import { features } from '../lib/flags';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

/**
 * Der Entwurf zeigt das Formular als eine Karte auf dem Papier-Grund:
 * unterstrichene Felder ohne Kasten, Beschriftungen in Kapitaelchen, und
 * genau eine Zwischenueberschrift — «Wohnungswunsch». Kontakt und
 * Einverstaendnis tragen im Entwurf keine Legende; fuer Screenreader bleibt
 * sie als visually-hidden stehen, sonst waeren die Gruppen unbenannt.
 */
const roomOptions = ['2.5', '3.5', '4.5', '5.5'];

/**
 * Mindestflaeche in Quadratmetern. Der Wert geht ohne Einheit ans Feld.
 *
 * Alle drei Auswahllisten beginnen mit «noch offen» und keiner Vorauswahl.
 * Der Entwurf zeigt sie mit Werten — ein Select kann nicht leer aussehen —,
 * aber eine Vorauswahl wuerde einen Wunsch protokollieren, den niemand
 * geaeussert hat. «noch offen» steht im Entwurf selbst.
 */
const areaOptions = ['60', '80', '100', '120', '150'];

/**
 * Bezugstermin als Auswahl, nicht als Monat: das Projekt nennt keinen
 * Vermietungsstart, ein Monatsfeld wuerde eine Genauigkeit vorspiegeln, die
 * es nicht gibt. Die Schluessel sind sprachneutral, der Endpoint kennt sie.
 */
const moveInOptions = [
  { value: 'asap', label: t('anmeldung.moveInAsap') },
  { value: 'flexibel', label: t('anmeldung.moveInFlex') },
  { value: '2030', label: t('anmeldung.moveIn2030') },
  { value: '2032', label: t('anmeldung.moveIn2032') },
];

/**
 * Einstellplatz: eine Auswahl statt zweier Haken, weil «mit» und «ohne»
 * einander ausschliessen. «noch offen» steht wie bei den anderen Listen
 * voran — kein Platz ist etwas anderes als keine Angabe.
 */
const parkingOptions = [
  { value: 'ohne', label: t('anmeldung.parkingPlain') },
  { value: 'mit', label: t('anmeldung.parkingCharger') },
];

/**
 * Mehrfachauswahl: Haken, keine Liste. Es sind Wuensche, die sich nicht
 * ausschliessen — eine Attikawohnung mit Bastelraum und Hund ist moeglich.
 * Die Schluessel sind sprachneutral, der Endpoint kennt sie (EXTRAS).
 */
const extraOptions = [
  { value: 'garten', label: t('anmeldung.extraGarden') },
  { value: 'attika', label: t('anmeldung.extraAttic') },
  { value: 'bastelraum', label: t('anmeldung.extraHobby') },
  { value: 'haustier', label: t('anmeldung.extraPet') },
];
---

<form class="form" action={withBase("/api/anmeldung.php")} method="post" data-form novalidate>
  <input type="hidden" name="locale" value={locale} />
  {/* Honeypot: fuer Menschen unsichtbar und aus dem Tab-Fluss genommen.
      Ist das Feld gefuellt, sortiert der Endpoint die Anfrage aus. */}
  <div class="form__trap" aria-hidden="true">
    <label for="website">Website</label>
    <input id="website" type="text" name="website" tabindex="-1" autocomplete="off" />
  </div>
  {/* Dauer des Ausfuellens in Millisekunden, gesetzt beim Absenden. Ohne
      JavaScript bleibt das Feld leer und zaehlt in der Spamabwehr nicht
      mit — das Formular funktioniert dann unveraendert. */}
  <input type="hidden" name="gestartet" value="" data-elapsed />

  <fieldset class="form__set">
    <legend class="visually-hidden">{t('anmeldung.legendContact')}</legend>

    <div class="form__grid">
      <p class="form__field">
        <label for="firstName">
          {t('anmeldung.firstName')}
          <span class="visually-hidden">{t('anmeldung.requiredHint')}</span>
        </label>
        <input
          id="firstName"
          name="firstName"
          type="text"
          autocomplete="given-name"
          required
          aria-describedby="firstName-error"
        />
        <span class="form__error" id="firstName-error" data-error-for="firstName"></span>
      </p>

      <p class="form__field">
        <label for="lastName">
          {t('anmeldung.lastName')}
          <span class="visually-hidden">{t('anmeldung.requiredHint')}</span>
        </label>
        <input
          id="lastName"
          name="lastName"
          type="text"
          autocomplete="family-name"
          required
          aria-describedby="lastName-error"
        />
        <span class="form__error" id="lastName-error" data-error-for="lastName"></span>
      </p>

      <p class="form__field">
        <label for="email">
          {t('anmeldung.email')}
          <span class="visually-hidden">{t('anmeldung.requiredHint')}</span>
        </label>
        <input
          id="email"
          name="email"
          type="email"
          autocomplete="email"
          inputmode="email"
          required
          aria-describedby="email-error"
        />
        <span class="form__error" id="email-error" data-error-for="email"></span>
      </p>

      <p class="form__field">
        <label for="phone">{t('anmeldung.phone')}</label>
        <input id="phone" name="phone" type="tel" autocomplete="tel" inputmode="tel" />
      </p>
    </div>
  </fieldset>

  <fieldset class="form__set form__set--wish">
    <legend class="form__legend">{t('anmeldung.legendWish')}</legend>

    <div class="form__grid">
      <p class="form__field">
        <label for="rooms">{t('anmeldung.rooms')}</label>
        <select id="rooms" name="rooms">
          <option value="">{t('anmeldung.roomsAny')}</option>
          {roomOptions.map((option) => <option value={option}>{option}</option>)}
        </select>
      </p>

      <p class="form__field">
        <label for="area">{t('anmeldung.area')}</label>
        <select id="area" name="area">
          <option value="">{t('anmeldung.areaAny')}</option>
          {areaOptions.map((option) => <option value={option}>{option} m²</option>)}
        </select>
      </p>

      <p class="form__field">
        <label for="moveIn">{t('anmeldung.moveIn')}</label>
        <select id="moveIn" name="moveIn">
          <option value="">{t('anmeldung.moveInAny')}</option>
          {moveInOptions.map((option) => <option value={option.value}>{option.label}</option>)}
        </select>
      </p>

      <p class="form__field">
        <label for="parking">{t('anmeldung.parking')}</label>
        <select id="parking" name="parking">
          <option value="">{t('anmeldung.parkingAny')}</option>
          {parkingOptions.map((option) => <option value={option.value}>{option.label}</option>)}
        </select>
      </p>
    </div>

    <fieldset class="form__sub">
      <legend class="form__sublegend">{t('anmeldung.extras')}</legend>
      <ul class="form__checks">
        {
          extraOptions.map((option) => (
            <li class="form__check">
              <input id={`extra-${option.value}`} name="extras[]" type="checkbox" value={option.value} />
              <label for={`extra-${option.value}`}>{option.label}</label>
            </li>
          ))
        }
      </ul>
    </fieldset>

    <p class="form__field form__field--wide">
      <label for="message">{t('anmeldung.message')}</label>
      <textarea id="message" name="message" rows="3"></textarea>
    </p>
  </fieldset>

  <fieldset class="form__set form__set--consent">
    <legend class="visually-hidden">{t('anmeldung.legendConsent')}</legend>

    <p class="form__check">
      <input id="consent" name="consent" type="checkbox" required aria-describedby="consent-error" />
      <label for="consent">{t('anmeldung.consent')}</label>
    </p>
    <span class="form__error" id="consent-error" data-error-for="consent"></span>
  </fieldset>

  <div class="form__actions">
    {/* In einer statischen Vorschau gibt es keinen PHP-Endpoint. Absenden
        wuerde auf eine 404 laufen, also ist der Knopf dort gesperrt. */}
    <button class="form__submit" type="submit" data-submit disabled={features.staticPreview}>
      <span data-submit-idle>{t('anmeldung.submit')}</span>
      <span data-submit-busy hidden>{t('anmeldung.submitting')}</span>
    </button>
  </div>

  <div class="form__status" data-status role="status" aria-live="polite" tabindex="-1" hidden>
    <p class="form__status-title" data-status-title></p>
    <p class="form__status-body" data-status-body></p>
  </div>

  {/* Texte fuer das Client-Skript: keine Strings im JS, alles uebersetzt. */}
  <script
    is:inline
    type="application/json"
    data-form-messages
    set:html={JSON.stringify({
      errors: {
        firstName: t('anmeldung.errors.firstName'),
        lastName: t('anmeldung.errors.lastName'),
        email: t('anmeldung.errors.email'),
        consent: t('anmeldung.errors.consent'),
        rateLimit: t('anmeldung.errors.rateLimit'),
        generic: t('anmeldung.errors.generic'),
      },
      successTitle: t('anmeldung.successTitle'),
      successBody: t('anmeldung.successBody'),
      errorTitle: t('anmeldung.errorTitle'),
      errorBody: t('anmeldung.errorBody'),
    })}
  />
</form>

<style>
  /* Den Rahmen traegt die Karte drumherum (.anm__form), nicht das Formular:
     so bleibt die Flaeche auch dann eine, wenn oben ein Status steht. */
  .form {
    display: grid;
    gap: 0;
    max-width: none;
  }

  .form__trap {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .form__set {
    margin: 0;
    padding: 0;
    border: 0;
  }

  /* Abstand als margin, nicht als padding: ein <legend> sitzt an der
     Rahmenkante des fieldset und ignoriert dessen padding-top — mit padding
     rutschte die Zwischenueberschrift in die Zeile darueber. */
  .form__set--wish {
    margin-top: clamp(1.5rem, 2.5vw, 2.125rem);
  }

  .form__set--consent {
    margin-top: var(--space-m);
  }

  .form__legend {
    padding: 0 0 0.875rem;
    font-size: 0.75rem;
    font-weight: var(--fw-bold);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--c-text);
  }

  .form__grid {
    display: grid;
    gap: 1.125rem;
    grid-template-columns: 1fr;
  }

  .form__field {
    display: grid;
    gap: 0.4375rem;
    align-content: start;
    max-width: none;
    margin: 0;
  }

  .form__field--wide {
    margin-top: 1.625rem;
  }

  /* Beschriftung in Kapitaelchen, wie im Entwurf. */
  .form__field label {
    font-size: 0.75rem;
    font-weight: var(--fw-semibold);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--c-text-subtle);
  }

  /* Unterstrichene Felder ohne Kasten: nur die Grundlinie traegt. */
  .form__field input,
  .form__field select {
    min-height: 2.375rem;
    padding: 0.5625rem 0;
    background: none;
    border: 0;
    border-bottom: var(--border-width) solid var(--c-field-line);
    font-size: 1rem;
    font-weight: var(--fw-light);
  }

  .form__field textarea {
    padding: 0.75rem;
    background: var(--c-bg);
    border: var(--border-width) solid var(--c-field-line);
    font-size: 1rem;
    font-weight: var(--fw-light);
    resize: vertical;
  }

  .form__field input:hover,
  .form__field select:hover,
  .form__field textarea:hover {
    border-color: var(--c-text);
  }

  .form__field [aria-invalid='true'] {
    border-color: var(--c-accent);
  }

  .form__error:empty {
    display: none;
  }

  .form__error {
    font-size: var(--fs-caption);
    color: var(--c-accent);
  }

  /* Die Wunsch-Haken: eine Gruppe im Gruppenfeld, eine Stufe leiser als
     die Legende darueber. */
  .form__sub {
    margin: 1.625rem 0 0;
    padding: 0;
    border: 0;
  }

  .form__sublegend {
    padding: 0 0 0.6875rem;
    font-size: 0.75rem;
    font-weight: var(--fw-semibold);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--c-text-subtle);
  }

  .form__checks {
    display: grid;
    gap: 0.6875rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .form__check {
    display: flex;
    align-items: start;
    gap: 0.75rem;
    max-width: none;
    margin: 0;
  }

  .form__check label {
    font-size: 0.84375rem;
    font-weight: var(--fw-light);
    line-height: 1.5;
    color: var(--c-text-muted);
  }

  .form__check input {
    width: 1.0625rem;
    height: 1.0625rem;
    margin-top: 0.1875rem;
    flex: none;
    accent-color: var(--c-accent);
  }

  .form__actions {
    padding-top: 1.75rem;
  }

  /* Der Knopf traegt die ganze Breite der Karte — so zeigt es der Entwurf. */
  .form__submit {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    min-height: 3.25rem;
    padding-inline: var(--space-m);
    background: var(--c-accent);
    color: var(--c-text-inverse);
    border: var(--border-width) solid var(--c-accent);
    font-size: 0.9375rem;
    font-weight: var(--fw-medium);
    transition:
      background-color var(--duration) var(--ease),
      border-color var(--duration) var(--ease);
  }

  .form__submit:hover:not([disabled]) {
    background: var(--c-accent-hover);
    border-color: var(--c-accent-hover);
  }

  .form__submit[disabled] {
    opacity: 0.6;
    cursor: not-allowed;
  }

  /* Waehrend des Sendens ist der Knopf ebenfalls disabled — dort passt
     der Warte-Cursor. */
  .form__submit[disabled]:has([data-submit-busy]:not([hidden])) {
    cursor: progress;
  }

  .form__status {
    margin-top: var(--space-m);
    padding: var(--space-m);
    border: var(--hairline);
    background: var(--c-bg);
  }

  .form__status[data-state='error'] {
    border-color: var(--c-accent);
  }

  .form__status-title {
    font-size: var(--fs-h3);
    font-weight: var(--fw-regular);
  }

  .form__status-body {
    padding-top: var(--space-2xs);
    font-size: var(--fs-small);
    color: var(--c-text-muted);
  }

  @media (min-width: 34rem) {
    .form__grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .form__checks {
      grid-template-columns: repeat(2, 1fr);
      column-gap: 1.125rem;
    }
  }
</style>

<script>
  import { initForm } from '../scripts/form';
  initForm();
</script>
