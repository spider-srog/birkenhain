---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Bildband from '../Bildband.astro';
import DistanzListe from '../DistanzListe.astro';
import Hero from '../Hero.astro';
import Karte from '../Karte.astro';
import VeloFussverkehr from '../VeloFussverkehr.astro';
import { useTranslations } from '../../i18n/ui';
import { hasCoordinates } from '../../lib/projekt';
import type { Locale } from '../../i18n/routes';
import aerial from '../../assets/aerial.jpg';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
---

<BaseLayout page="lage" locale={locale} title={t('lage.metaTitle')} description={t('lage.metaDescription')}>
  <Hero kicker={t('lage.kicker')} title={t('lage.title')} />

  <section class="lage__intro container cols cols--tight">
    <div data-reveal>
      <p class="lage__p">{t('lage.p1')}</p>
      <p class="lage__p lage__p--muted">{t('lage.p2')}</p>
    </div>

    <DistanzListe locale={locale} />
  </section>

  {
    hasCoordinates() && (
      <div class="lage__map container">
        <Karte locale={locale} />
      </div>
    )
  }

  <VeloFussverkehr locale={locale} />

  <Bildband src={aerial} alt={t('home.teaserLage')} size="sm" />
</BaseLayout>

<style>
  .lage__intro {
    padding-bottom: clamp(2.25rem, 4vw, 4rem);
    align-items: start;
  }

  .lage__p {
    max-width: none;
    margin: 0;
    font-size: var(--fs-body);
    font-weight: var(--fw-light);
    line-height: var(--lh-body);
    color: #54514d;
  }

  .lage__p--muted {
    margin-top: var(--space-s);
    font-size: var(--fs-small);
    color: var(--c-text-muted);
  }

  .lage__map {
    padding-bottom: clamp(2.5rem, 5vw, 4.5rem);
  }
</style>
